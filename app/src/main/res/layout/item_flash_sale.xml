<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="145dp"
    android:layout_height="wrap_content"
    android:layout_marginStart="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="5dp"
    android:layout_marginTop="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="145dp"
        android:orientation="vertical">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutimage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- Gambar Produk -->

            <ImageView
                android:id="@+id/productImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:src="@drawable/paksi_nagaliman_vector_belakang"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Badge Diskon -->
            <TextView
                android:id="@+id/discountBadge"
                android:layout_width="30dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:background="@drawable/rounded_corner_badge"
                android:gravity="top|center"
                android:layout_marginStart="97dp"
                android:layout_marginEnd="15dp"
                android:text="-20%"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>




        <!-- Harga Produk -->
        <TextView
            android:id="@+id/productPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:hint="harga"
            android:textColor="@color/utama"
            android:textSize="14sp" />




        <!-- Progress Bar Terjual -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ProgressBar
                    android:id="@+id/soldProgressBar"
                    android:layout_width="92dp"
                    android:layout_height="7dp"
                    android:layout_marginTop="2dp"
                    android:indeterminateOnly="false"
                    android:progress="50"
                    android:max="100"
                    android:progressDrawable="@drawable/rounded_progress"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/soldText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/white"
                    android:textSize="5sp"
                    app:layout_constraintBottom_toBottomOf="@+id/soldProgressBar"
                    app:layout_constraintEnd_toEndOf="@+id/soldProgressBar"
                    app:layout_constraintStart_toStartOf="@+id/soldProgressBar"
                    app:layout_constraintTop_toTopOf="@+id/soldProgressBar" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>